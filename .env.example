# Producción por defecto en Docker Compose. Use "desarrollo" sólo en su computador.
ENTORNO=produccion
# Dominio del panel con https://, p. ej. https://administracion.miempresa.cl
CORS_ORIGINS=
DB_PASSWORD=cambiar
JWT_SECRET=cambiar-por-un-secreto-largo-de-32+-caracteres
WHATSAPP_WEBHOOK_TOKEN=cambiar
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_APIKEY=
ANTHROPIC_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_FROM=

# --- Retención de datos personales (días; 0 = no purgar). Ver docs/PRIVACIDAD.md ---
RETENCION_ACCESOS_DIAS=180
RETENCION_VISITAS_DIAS=90
RETENCION_EVENTOS_DIAS=365
RETENCION_INTENTOS_LOGIN_DIAS=30

# --- Publicación (HTTPS automático con Caddy) ---
# Dominio público del sistema, sin https:// (p. ej. administracion.miempresa.cl). Debe apuntar a este servidor.
DOMINIO=

# --- Conexiones a la base (por proceso: API, worker y beat abren las suyas) ---
# Con Supabase sume API + worker + beat: pool + overflow de cada uno no debe superar el límite de su plan.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=8
